                    }
                },
                "count": 5,
                "item_0": {
                    "cereal_class_version": 0,
                    "font_": {
                        "cereal_class_version": 0,
                        "value0": {
                            "polymorphic_id": 1073741824,
                            "ptr_wrapper": {
                                "id": 2147483650,
                                "data": {
                                    "cereal_class_version": 0,
                                    "value0": {
                                        "value_": "C48F5FF6-C374-4289-A3BF-3BAF6C9C24EC"
                                    }
                                }
                            }
                        }
                    },
                    "text_": "……来たんだ。\nこの骨、見せたかったんだよね。",
                    "textColor_": {
                        "cereal_class_version": 0,
                        "r_": 255,
                        "g_": 255,
                        "b_": 255
                    }
                },
                "item_1": {
                    "font_": {
                        "value0": {
                            "polymorphic_id": 1073741824,
                            "ptr_wrapper": {
                                "id": 2147483651,
                                "data": {
                                    "value0": {
                                        "value_": "C48F5FF6-C374-4289-A3BF-3BAF6C9C24EC"
                                    }
                                }
                            }
                        }
                    },
                    "text_": "昔、ある島を守ってた竜だよ。\n北の城塞が、その島。私の故郷。",
                    "textColor_": {
                        "r_": 255,
                        "g_": 255,
                        "b_": 255
                    }
                },
                "item_2": {
                    "font_": {
                        "value0": {
                            "polymorphic_id": 1073741824,
                            "ptr_wrapper": {
                                "id": 2147483652,
                                "data": {
                                    "value0": {
                                        "value_": "C48F5FF6-C374-4289-A3BF-3BAF6C9C24EC"
                                    }
                                }
                            }
                        }
                    },
                    "text_": "あの古竜に心臓を喰われて、島ごと\n空から落ちた。守り竜も、ここで。",
                    "textColor_": {
                        "r_": 255,
                        "g_": 255,
                        "b_": 255
                    }
                },
                "item_3": {
                    "font_": {
                        "value0": {
                            "polymorphic_id": 1073741824,
                            "ptr_wrapper": {
                                "id": 2147483653,
                                "data": {
                                    "value0": {
                                        "value_": "C48F5FF6-C374-4289-A3BF-3BAF6C9C24EC"
                                    }
                                }
                            }
                        }
                    },
                    "text_": "でも見て。頭と胸の骨が無い。\n……砂の跡が、城塞へ続いてる。",
                    "textColor_": {
                        "r_": 255,
                        "g_": 255,
                        "b_": 255
                    }
                },
                "item_4": {
                    "font_": {
                        "value0": {
                            "polymorphic_id": 1073741824,
                            "ptr_wrapper": {
                                "id": 2147483654,
                                "data": {
                                    "value0": {
                                        "value_": "C48F5FF6-C374-4289-A3BF-3BAF6C9C24EC"
                                    }
                                }
                            }
                        }
                    },
                    "text_": "光る石が、守り竜を起こしたんだ。\n……眠らせてあげて。お願い。",
                    "textColor_": {
                        "r_": 255,
                        "g_": 255,
                        "b_": 255
                    }
                }
            }
        }
    }
}