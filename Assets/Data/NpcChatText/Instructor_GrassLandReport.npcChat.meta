                                    }
                                }
                            }
                        }
                    },
                    "text_": "緑の浮遊石、確かに受け取った。\n島の揺れが、嘘みたいに収まった。",
                    "textColor_": {
                        "cereal_class_version": 0,
                        "r_": 255,
                        "g_": 255,
                        "b_": 255
                    }
                },
                "item_1": {
                    "font_": {
                        "value0": {
                            "polymorphic_id": 1073741824,
                            "ptr_wrapper": {
                                "id": 2147483651,
                                "data": {
                                    "value0": {
                                        "value_": "C48F5FF6-C374-4289-A3BF-3BAF6C9C24EC"
                                    }
                                }
                            }
                        }
                    },
                    "text_": "草原の狩人たちも、こっちへ\n来てくれるそうだな。",
                    "textColor_": {
                        "r_": 255,
                        "g_": 255,
                        "b_": 255
                    }
                },
                "item_2": {
                    "font_": {
                        "value0": {
                            "polymorphic_id": 1073741824,
                            "ptr_wrapper": {
                                "id": 2147483652,
                                "data": {
                                    "value0": {
                                        "value_": "C48F5FF6-C374-4289-A3BF-3BAF6C9C24EC"
                                    }
                                }
                            }
                        }
                    },
                    "text_": "住む場所を用意せんとな。\n……やることは山積みだ。",
                    "textColor_": {
                        "r_": 255,
                        "g_": 255,
                        "b_": 255
                    }
                },
                "item_3": {
                    "font_": {
                        "value0": {
                            "polymorphic_id": 1073741824,
                            "ptr_wrapper": {
                                "id": 2147483653,
                                "data": {
                                    "value0": {
                                        "value_": "C48F5FF6-C374-4289-A3BF-3BAF6C9C24EC"
                                    }
                                }
                            }
                        }
                    },
                    "text_": "残る浮遊石の行方は、今探らせている。\nそれまでは島の立て直しを頼む。",
                    "textColor_": {
                        "r_": 255,
                        "g_": 255,
                        "b_": 255
                    }
                }
            }
