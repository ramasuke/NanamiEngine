                                    }
                                }
                            }
                        }
                    },
                    "text_": "……終わったのか。\n本当に、あの大顎を。",
                    "textColor_": {
                        "cereal_class_version": 0,
                        "r_": 255,
                        "g_": 255,
                        "b_": 255
                    }
                },
                "item_1": {
                    "font_": {
                        "value0": {
                            "polymorphic_id": 1073741824,
                            "ptr_wrapper": {
                                "id": 2147483651,
                                "data": {
                                    "value0": {
                                        "value_": "C48F5FF6-C374-4289-A3BF-3BAF6C9C24EC"
                                    }
                                }
                            }
                        }
                    },
                    "text_": "あの光る石、あんたの島のものじゃな。\n持っていけ。石が去れば獣も散る。",
                    "textColor_": {
                        "r_": 255,
                        "g_": 255,
                        "b_": 255
                    }
                },
                "item_2": {
                    "font_": {
                        "value0": {
                            "polymorphic_id": 1073741824,
                            "ptr_wrapper": {
                                "id": 2147483652,
                                "data": {
                                    "value0": {
                                        "value_": "C48F5FF6-C374-4289-A3BF-3BAF6C9C24EC"
                                    }
                                }
                            }
                        }
                    },
                    "text_": "村を建て直すには時がかかる。\nその間、若い者を何人か預けたい。",
                    "textColor_": {
                        "r_": 255,
                        "g_": 255,
                        "b_": 255
                    }
                },
                "item_3": {
                    "font_": {
                        "value0": {
                            "polymorphic_id": 1073741824,
                            "ptr_wrapper": {
                                "id": 2147483653,
                                "data": {
                                    "value0": {
                                        "value_": "C48F5FF6-C374-4289-A3BF-3BAF6C9C24EC"
                                    }
                                }
                            }
                        }
                    },
                    "text_": "島を追われる辛さは、\nわしらが一番知っておる。",
                    "textColor_": {
                        "r_": 255,
                        "g_": 255,
                        "b_": 255
                    }
                },
                "item_4": {
                    "font_": {
                        "value0": {
                            "polymorphic_id": 1073741824,
                            "ptr_wrapper": {
                                "id": 2147483654,
                                "data": {
                                    "value0": {
                                        "value_": "C48F5FF6-C374-4289-A3BF-3BAF6C9C24EC"
                                    }
                                }
                            }
                        }
                    },
                    "text_": "あんたの島の立て直し、手伝わせてくれ。\n受けた恩は、狩人の流儀で返す。",
                    "textColor_": {
                        "r_": 255,
                        "g_": 255,
                        "b_": 255
                    }
                }
            }
        }
    }
