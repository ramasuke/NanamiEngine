                                    }
                                }
                            }
                        }
                    },
                    "text_": "おう、ハンターか！\nこんな砂の果てまで、よく来たな。",
                    "textColor_": {
                        "cereal_class_version": 0,
                        "r_": 255,
                        "g_": 255,
                        "b_": 255
                    }
                },
                "item_1": {
                    "font_": {
                        "value0": {
                            "polymorphic_id": 1073741824,
                            "ptr_wrapper": {
                                "id": 2147483651,
                                "data": {
                                    "value0": {
                                        "value_": "C48F5FF6-C374-4289-A3BF-3BAF6C9C24EC"
                                    }
                                }
                            }
                        }
                    },
                    "text_": "うちは島から島へ荷を運ぶ隊商だ。\nこの泉で、足止めを食らってる。",
                    "textColor_": {
                        "r_": 255,
                        "g_": 255,
                        "b_": 255
                    }
                },
                "item_2": {
                    "font_": {
                        "value0": {
                            "polymorphic_id": 1073741824,
                            "ptr_wrapper": {
                                "id": 2147483652,
                                "data": {
                                    "value0": {
                                        "value_": "C48F5FF6-C374-4289-A3BF-3BAF6C9C24EC"
                                    }
                                }
                            }
                        }
                    },
                    "text_": "数日前、金色に光る石が\n北の城塞跡に落ちてきてな。",
                    "textColor_": {
                        "r_": 255,
                        "g_": 255,
                        "b_": 255
                    }
                },
                "item_3": {
                    "font_": {
                        "value0": {
                            "polymorphic_id": 1073741824,
                            "ptr_wrapper": {
                                "id": 2147483653,
                                "data": {
                                    "value0": {
                                        "value_": "C48F5FF6-C374-4289-A3BF-3BAF6C9C24EC"
                                    }
                                }
                            }
                        }
                    },
                    "text_": "それから泉は日に日に細るし、\nサソリどもが水場まで出やがる。",
                    "textColor_": {
                        "r_": 255,
                        "g_": 255,
                        "b_": 255
                    }
                },
                "item_4": {
                    "font_": {
                        "value0": {
                            "polymorphic_id": 1073741824,
                            "ptr_wrapper": {
                                "id": 2147483654,
                                "data": {
                                    "value0": {
                                        "value_": "C48F5FF6-C374-4289-A3BF-3BAF6C9C24EC"
                                    }
                                }
                            }
                        }
                    },
                    "text_": "砂嵐で荷車も二台なくした。\n……頼む、力を貸してくれ。",
                    "textColor_": {
                        "r_": 255,
                        "g_": 255,
                        "b_": 255
                    }
                }
            }
        }
    }
