# Build files
*.exe
*.obj
*.pdb
*.ilk

# Build directories
Debug/
Release/
x64/
x86/
# Toolbar "Build" output (Config > Build > Output Directory)
/Build/
# Engine static lib (NanamiEngine.vcxproj) and its intermediates
/lib/
/obj/
# Engine distributions (tools/engine_dist)
/dist/

# Visual Studio
.vs/
*.vcxproj.users

# Python (tools/bt)
__pycache__/
*.pyc

# Runtime-generated logs
EngineLog.txt

# AutoMCP screenshots (tools/automcp; engine working directory = repo root)
/AutoMcp/

# Model sources (only the converted .mv1 is tracked)
*.fbx

# Asset distribution (tools/dist) - release artifacts, not sources
/manifest.json
/manifest-*.json
/installed.json
/.manifest_hash_cache.json

# HotReload PoC の出力 (tools/hotreload_poc/README.md)
tools/hotreload_poc/x64/
tools/hotreload_poc/linux_out/
# HotReload (Build & Reload) の MSBuild ログ
/Logs/HotReload/
# HotReload の保険モード設定 (開発者ごと)
/LocalPrefs/HotReload/
